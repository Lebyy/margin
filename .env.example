PORT=4000
LLM_API_KEY=
MONGODB_URI=
# Where student files are kept: "gcs" (the team's Google Cloud Storage bucket, set up 2026-11-15) or "local" (a folder on this machine).
STORAGE_DRIVER=local
# For local: the folder. Leave empty for storage/ at the repo root (git-ignored).
STORAGE_DIR=
# For gcs: the bucket name (askretes-student-files-62090fbe).
GCS_BUCKET=
# For gcs: the askretes-storage service account key file, base64 on one line. Get it from David privately; never commit it.
# (If unset, GOOGLE_APPLICATION_CREDENTIALS, a path to the key file, is used instead.)
GCS_KEY_BASE64=

# Sites allowed to call the API and open Talk (comma-separated). Unset = http://localhost:3000.
WEB_ORIGINS=
